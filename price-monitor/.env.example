PRICE_MONITOR_ENVIRONMENT=production
# Docker Compose default. For Supabase, replace this with the Session pooler URI from
# Project settings -> Connect, change postgresql:// to postgresql+psycopg://, and require SSL.
PRICE_MONITOR_DATABASE_URL=postgresql+psycopg://price_monitor:price_monitor@db:5432/price_monitor
# Optional: use Supabase's direct connection for Alembic while runtime processes use the
# session pooler above. The runtime URL is used when this is omitted.
# PRICE_MONITOR_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
PRICE_MONITOR_ARTIFACT_ROOT=/app/var/artifacts
PRICE_MONITOR_ADAPTER_RUNTIME_ROOT=/app/var/adapters
# PRICE_MONITOR_ALEMBIC_CONFIG=/app/alembic.ini
# Share this only with the server-side dashboard deployment; never expose it as NEXT_PUBLIC_*.
# PRICE_MONITOR_API_TOKEN=generate-at-least-32-random-characters
# Vercel sends CRON_SECRET automatically to the protected scheduled endpoint.
# CRON_SECRET=generate-a-different-at-least-32-character-secret
# A single scheduled invocation processes at most this many targets.
PRICE_MONITOR_CRON_MAX_SCRAPES=5
# Development/test only: seed bundled offline records into an empty database at app startup.
# Rejected in preview/production. CLI alternative: `price-monitor seed-development`.
# PRICE_MONITOR_SEED_DEVELOPMENT_DATA=true
PRICE_MONITOR_USER_AGENT=PriceMonitorBeta/0.1 (+mailto:ops@example.com)
PRICE_MONITOR_RESPECT_ROBOTS_TXT=true
PRICE_MONITOR_DEFAULT_MINIMUM_REQUEST_INTERVAL_MS=1000
PRICE_MONITOR_MAXIMUM_RETRIES=2
PRICE_MONITOR_REPAIR_FAILURE_THRESHOLD=3
PRICE_MONITOR_REPAIR_MINIMUM_DISTINCT_TARGETS=2
# The deterministic provider is the safe default. To opt in to model-assisted proposals:
# PRICE_MONITOR_REPAIR_PROVIDER=openai
# PRICE_MONITOR_OPENAI_REPAIR_MODEL=your-enabled-model-id
# PRICE_MONITOR_OPENAI_API_KEY=replace-me
