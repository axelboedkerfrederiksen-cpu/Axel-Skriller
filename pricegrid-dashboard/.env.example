# The dashboard stays on demo data unless this is explicitly false.
PRICEGRID_USE_MOCK_API=true

# Server-only connection to the independently deployed Price Monitor API.
# Do not rename these variables to NEXT_PUBLIC_*.
PRICE_MONITOR_API_BASE_URL=http://127.0.0.1:8000
PRICE_MONITOR_CUSTOMER_ID=replace-with-a-customer-uuid
# Optional for local development; required when the backend has API protection enabled.
# PRICE_MONITOR_API_TOKEN=use-the-same-at-least-32-character-token-as-the-backend
